// Copy this file to creatio.env.config.json and fill it in.
// The real file is gitignored, because it holds a password.
{
  "BaseUrl": "https://your-instance.creatio.com",

  // Optional. Set only when the auth service is not at BaseUrl plus the AuthPath
  // from creatio.site.config.json.
  // "AuthUrl": "https://your-instance.creatio.com/ServiceModel/AuthService.svc/Login",

  "Users": [
    {
      "Username": "Supervisor",
      "Password": "put-the-password-here"
    }
  ],

  // Folders scanned for test cases.
  "CasesFolders": [ "./Cases" ],

  // Folders scanned for analysis scripts. They run only when analysis is asked for,
  // with --analyse or --analyse-only.
  "AnalysisFolders": [ "./Analysis" ]
}
