# Build output
bin/
obj/
[Bb]uild/
artifacts/

# Visual Studio / Rider / VS Code
.vs/
.idea/
*.user
*.suo
*.userprefs
*.userosscache
*.sln.docstates

# Logs and temp
*.log
*.tlog
*.tmp
*.bak
*.old
*.swp
[Ll]og/
[Ll]ogs/

# Test artifacts
Reports/
TestResults/

# Playwright
.playwright/
playwright-report/

# Reference copy of the pre-refactoring framework
source/*

# Holds a real password. Copy creatio.env.config.example.json to create it.
Configuration/creatio.env.config.json

# Our own working material, not part of the framework
ai_helpers/*
backlog/*
copilot/*
internal_docs/*
# MCP server
mcp-server/.venv/
__pycache__/

# Cases, analysis scripts and page/process files are written against someone's own environment
# and name its schemas, so they stay local. Only the bundled examples below are tracked; to add
# one, add a negation line next to the others.
Cases/*.act
!Cases/all-value-types.act
!Cases/contact-form-baseline.act
!Cases/contact-form-tabs.act
!Cases/grid-add-record.act
!Cases/grid-columns.act
!Cases/grid-detail.act
!Cases/lookup-goto.act
!Cases/readonly-presence.act
!Cases/toggle-tab.act
ProcessCases/*.act
Analysis/*.act
!Analysis/discover-contact-form.act
!Analysis/discover-lead-form.act
!Analysis/discover-usr-test-form.act
Configuration/pages/*.json
!Configuration/pages/AccountForm.json
!Configuration/pages/ContactForm.json
!Configuration/pages/LeadForm.json
!Configuration/pages/OpportunityForm.json
!Configuration/pages/TaskForm.json
!Configuration/pages/UsrTestForm.json
Configuration/processes/*.json
