# S12-T05: the rules built with rules.py act on the page.
#   page rule   : website and the orders grid are hidden until a contact is chosen
#   object rules: notes required and description set when urgent; manager read-only when done
# The page is never saved.

use Supervisor
open iaOrderForm for a1b2c3d4-0000-4000-8000-000000000001

click GeneralInfoTab

# page rule, before and after the trigger
check iaWebsite not exists
check iaOrdersGrid not exists
set iaContact "Supervisor"
check iaWebsite exists
check iaOrdersGrid exists

# object rules: required + set value
check iaNotes is not required
set iaIsUrgent "true"
wait 1 second
check iaNotes is required
check-value iaDescription eq "Urgent order"

# object rule: read-only
check iaManager is not readonly
set iaStatus "Done"
wait 1 second
check iaManager is readonly

end
