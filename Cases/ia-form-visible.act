# Test bed for dynamic pages (tasks S11-T01), the record where every rule keeps its controls shown:
# iaIsActive is true (dates shown) and the contact is set (comment and order grid shown).

use Supervisor
open iaTestsForm for 6652a8c8-d7ff-472d-a184-1d90533039c3

click GeneralInfoTab

check-value iaContactLookup eq "Supervisor"
check iaComment exists
check iaOrderList exists
check iaDate exists
check iaDateTime exists
end
